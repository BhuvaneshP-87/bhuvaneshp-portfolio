---
import { siteConfig } from "../config";

const hasSkillCategories =
  siteConfig.skillCategories && siteConfig.skillCategories.length > 0;
---

{
  hasSkillCategories && (
    <section id="skills" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900">
              Technical Skills
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
          </div>

          <div class="lg:col-span-8">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
              {siteConfig.skillCategories.map((category) => (
                <div class="rounded-2xl border border-gray-200 bg-white p-5 sm:p-6 shadow-sm">
                  <h3 class="text-lg sm:text-xl font-semibold text-gray-900">
                    {category.name}
                  </h3>
                  <p class="mt-3 text-sm sm:text-base leading-7 text-gray-600">
                    {category.items.join(" • ")}
                  </p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
